# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required for Google Sign-In.
# This must be an OAuth 2.0 **Web application** Client ID from Google Cloud
# Console > APIs & Services > Credentials. It's used directly by the browser
# (Google Identity Services) sign-in flow, and is also read by
# capacitor.config.ts (as GoogleAuth.serverClientId) so the native Android
# Google Sign-In flow issues an ID token scoped to this same client.
#
# The native Android app additionally needs a *separate* OAuth 2.0
# **Android** Client ID to exist in the same Google Cloud project, registered
# with this app's package name (com.steadyhands.balance) and the SHA-1
# fingerprint of the signing key used to build the APK/AAB (debug and release
# keys each need their own entry). That Android client ID is never referenced
# in code/config -- Google matches it by package name + SHA-1 automatically.
VITE_GOOGLE_CLIENT_ID=""

# Google AdMob App ID & Publisher ID & Banner Unit ID
VITE_ADMOB_APP_ID="ca-app-pub-4833668827116420~3753425596"
VITE_ADMOB_PUBLISHER_ID="ca-pub-4833668827116420"
VITE_ADMOB_BANNER_UNIT_ID="ca-app-pub-4833668827116420/8214685836"
